# =============================================================================
# Plantilla de variables de entorno.
#
# Copiar a .env.local (ignorado por git) y llenar. En producción, las mismas
# van en las variables de entorno de cada proyecto de Vercel.
#
# La columna "app" dice quién la necesita: B=bot, M=menú, P=portal.
# =============================================================================


# --- Base de datos -------------------------------------------- [B] [M] [P] --
# Neon: neon.tech -> proyecto nuevo -> Connection string.
# En desarrollo puede apuntar a un Postgres local; el driver se elige solo
# según la forma de la cadena.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/dbname?sslmode=require"


# =============================================================================
# META / WHATSAPP CLOUD API                                            [B]
# =============================================================================
# El número es COMPARTIDO con otro bot (Qanelo) — se rota a mano entre los
# dos, nunca los dos activos a la vez (ver ADR-10 en docs/DECISIONS.md y
# BOT_ACTIVE más abajo). Las cuatro variables de acá son las MISMAS que usa
# el otro bot, porque es la misma app de Meta y el mismo número.
#
# ⚠️ No las generes ni las rotes vos. Si las cambiás, rompés el otro bot.
# Pedíselas a quien administra la app de Meta (no accedés al panel).
#
# El webhook tampoco lo configurás vos en Meta: la URL que Meta conoce es
# fija y apunta a un nginx que decide, con un interruptor manual, a cuál de
# los dos bots reenviar cada entrega. Ver docs/DEPLOYMENT.md para qué URL dar
# y qué confirmar antes de pedir la rotación hacia este bot.

# El "Phone number ID" del número compartido.
WHATSAPP_PHONE_NUMBER_ID=""

# El token permanente de System User del número compartido (no el temporal
# de la consola, que dura 24 h).
WHATSAPP_ACCESS_TOKEN=""

# El verify token que ya está configurado en el panel de Meta para ese
# webhook. Da igual si vos no lo elegiste: tiene que ser IGUAL acá.
WHATSAPP_VERIFY_TOKEN=""

# El App Secret de esa misma app de Meta. Con esto se verifica que cada
# webhook viene de verdad de Meta antes de procesar nada.
WHATSAPP_APP_SECRET=""

# Versión de la Graph API. Subirla es un cambio deliberado, no automático.
WHATSAPP_API_VERSION="v21.0"

# El candado de la rotación (ver ADR-10). "false" por defecto — hay que
# ponerlo en "true" a propósito cuando el nginx compartido ya está apuntando
# hacia este bot, y volverlo a "false" antes de devolverle el turno a
# Qanelo. Con esto en "false", ningún camino de salida manda nada al número
# compartido, ni el webhook ni el cron del outbox, así el proceso siga
# corriendo.
BOT_ACTIVE="false"


# =============================================================================
# OPENAI                                                               [B]
# =============================================================================
# platform.openai.com -> API keys.
OPENAI_API_KEY=""

# Conversación. Es el mismo modelo que usa el sistema real.
OPENAI_CHAT_MODEL="gpt-4o-mini"
# Notas de voz.
OPENAI_TRANSCRIBE_MODEL="whisper-1"
# Lectura de comprobantes de pago.
OPENAI_VISION_MODEL="gpt-4o-mini"


# =============================================================================
# ENLACES ENTRE LAS TRES APPS
# =============================================================================
# Las tres se despliegan por separado, así que se hablan por HTTP.
# En local son los puertos de abajo; en producción, las URLs de Vercel.

MENU_URL="http://localhost:3002"          # [B] [P]
PORTAL_URL="http://localhost:3003"        # [B]
# Portal con pedidos de ejemplo en memoria, sin base de datos (para grabar el
# video o probar el diseño). NUNCA en producción: la cocina prepararía pedidos
# falsos.
NEXT_PUBLIC_PORTAL_DEMO="false"
BOT_URL="http://localhost:3001"           # [M] [P]

# Secreto compartido que protege los endpoints internos que disparan mensajes
# de WhatsApp. Generar con:  openssl rand -hex 32
INTERNAL_SECRET=""                        # [B] [M] [P]

# Firma los links del menú, que son los que dicen de qué teléfono es la
# conversación. DEBE ser idéntico en bot y menú, o el pedido no vuelve solo a
# WhatsApp.  Generar con:  openssl rand -hex 32
MENU_TOKEN_SECRET=""                      # [B] [M]


# =============================================================================
# NEGOCIO                                                          [B] [M] [P]
# =============================================================================
# Una sola fuente para el prompt del asistente, el pie del menú y las
# preguntas frecuentes.

BUSINESS_NAME="Brasa & Pan"
# Una línea para el héroe del menú. Opcional — vacío por defecto.
BUSINESS_TAGLINE="Parrilla y panadería propia"
# Horario. SIN ESTAS TRES la demo atiende 24/7 (0–24): fuera de horario el
# bot corta y contesta "ya cerramos" (RF-12), y eso, de noche, tapa todo lo
# demás. Descoméntalas para que el negocio tenga horario real.
# BUSINESS_HOURS="Lunes a domingo, 11:00 a.m. a 10:00 p.m."
# BUSINESS_OPENS_HOUR="11"
# BUSINESS_CLOSES_HOUR="22"
BUSINESS_TIMEZONE="America/Bogota"
BUSINESS_ADDRESS="Calle 10 #20-30, Bogotá"

# El número de WhatsApp del negocio (el compartido con Qanelo, ADR-11), en
# formato internacional sin "+" ni espacios. Lo usa el MENÚ para abrir el chat
# al enviar el pedido: con el envío automático solo abre la conversación, y si
# el pedido no pudo volver solo, es el número al que va el "#PEDIDO <código>"
# de respaldo (RF-27).
#
# Es el número, no el `phone_number_id` — son dos cosas distintas y solo esta
# sirve para abrir un chat.
BUSINESS_WHATSAPP_NUMBER="15551752148"

# Foto de la bienvenida, que el bot manda con el primer saludo.  [B]
#
# OPCIONAL: sin ella el saludo sale igual, solo sin imagen. Tiene que ser una
# URL PÚBLICA que sirva la imagen directamente — Meta la descarga él mismo, así
# que una página que "muestra" la foto no sirve. La que viene por defecto la
# sirve el propio menú desde `apps/menu/public/`.
WELCOME_IMAGE_URL="https://demo-delivery-system-menu.vercel.app/bienvenida.jpg"

DELIVERY_FEE="5000"
DELIVERY_TIME="30 a 45 minutos"
MIN_ORDER="20000"
DELIVERY_ZONE="Cobertura de domicilio en un radio de 4 km."

PAYMENT_NEQUI="300 123 4567"
PAYMENT_BANK="Bancolombia ahorros 123-456789-00"


# =============================================================================
# OPERACIÓN                                                            [B]
# =============================================================================
# Dónde se guardan audios y comprobantes.
# En Vercel el disco es efímero: solo /tmp es escribible y se borra entre
# invocaciones. Para conservarlos hace falta almacenamiento externo (Fase 5).
MEDIA_DIR="/tmp/media"

# Tope de mensajes por cliente por hora. Cortafuegos contra un bucle o contra
# alguien jugando. 0 = sin tope.
MAX_MESSAGES_PER_HOUR="60"
